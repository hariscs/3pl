// 3plwork unified schema.
// Source of truth for the Dockmaster back-office domain (customers, employees,
// product types + rate cards, loads, users) AND the Lead field app
// (leads, assignments, check-ins) which projects from the same models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  active
  archived
}

enum Role {
  admin
  lead
}

enum LoadStatus {
  active
  complete
  void
  archived
}

enum CheckInStatus {
  active
  completed
}

model Location {
  id     String @id @default(cuid())
  name   String
  region String

  // Lead field-app config. Optional: a location may or may not be lead-enabled.
  code            String? @unique
  group           String?
  addressL1       String?
  city            String?
  state           String?
  postalCode      String?
  timezone        String  @default("America/New_York")
  status          String  @default("active")
  containerFields Json?
  permissions     Json?
  featureFlags    Json?
  shiftStart      String  @default("08:00")
  shiftEnd        String  @default("17:00")

  customers    Customer[] // implicit many-to-many
  employees    Employee[]
  productTypes ProductType[]
  loads        Load[]
  assignments  LeadAssignment[]
  checkIns     CheckIn[]
}

model Customer {
  id               String       @id @default(cuid())
  contactName      String
  email            String
  phone            String
  displayName      String
  legalCompanyName String
  status           RecordStatus @default(active)

  locations    Location[] // implicit many-to-many
  productTypes ProductType[]
  loads        Load[]
}

model Employee {
  id         String       @id @default(cuid())
  name       String
  email      String
  phone      String
  address    String
  hourlyRate Float
  status     RecordStatus @default(active)

  location    Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String
  assignments LoadEmployeeAssignment[]
}

model ProductType {
  id     String       @id @default(cuid())
  name   String
  status RecordStatus @default(active)

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  rateLines  RateLine[]
  loads      Load[]
}

model RateLine {
  id            String @id @default(cuid())
  unit          String
  billBase      Float
  billThreshold Float
  billOverRate  Float
  payThreshold  Float
  payOverRate   Float
  payBonus      Float

  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  productTypeId String
}

model Load {
  id              String     @id @default(cuid())
  ticketNumber    Int        @unique
  date            String // ISO date (YYYY-MM-DD)
  doorNumber      String
  containerNumber String
  vendor          String
  poNumbers       String[]
  sorts           Int
  cases           Int
  weight          Int
  status          LoadStatus @default(active)
  billedAmount    Float      @default(0)
  payoutAmount    Float      @default(0)

  location      Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String
  customer      Customer                 @relation(fields: [customerId], references: [id])
  customerId    String
  productType   ProductType              @relation(fields: [productTypeId], references: [id])
  productTypeId String
  assignments   LoadEmployeeAssignment[]
}

model LoadEmployeeAssignment {
  id         String  @id @default(cuid())
  clockIn    String
  clockOut   String?
  load       Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  loadId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
}

model SystemUser {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String?
  role         Role         @default(lead)
  locationId   String
  status       RecordStatus @default(active)
}

// ---------------------------------------------------------------------------
// Lead field app
// ---------------------------------------------------------------------------

model Lead {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("Lead Supervisor")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments LeadAssignment[]
  checkIns    CheckIn[]
}

model LeadAssignment {
  id            String  @id @default(cuid())
  lead          Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String
  role          String  @default("Lead Supervisor")
  shiftStart    String  @default("08:00")
  shiftEnd      String  @default("17:00")
  distanceMiles Float?

  @@unique([leadId, locationId])
}

model CheckIn {
  id           String        @id @default(cuid())
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String
  status       CheckInStatus @default(active)
  deviceId     String?
  checkedInAt  DateTime      @default(now())
  checkedOutAt DateTime?
}
